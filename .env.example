# ─── Required ────────────────────────────────────────────────────────────────

# The Minecraft server the bot joins (add :port if it is not 25565)
MC_HOST=2b2t.org

# The in-game name of the Microsoft account the bot plays on
MC_USERNAME=YourBotAccount

# ─── Optional ────────────────────────────────────────────────────────────────

# Minecraft protocol version to use
#MC_VERSION=1.20.1

# The port you connect your own Minecraft client to (default 25577)
#PROXY_PORT=25577

# Discord bot token, for the /load and /connect slash commands
#DISCORD_BOT_TOKEN=

# Discord webhook URL, for pearl and alert notifications
#DISCORD_WEBHOOK_URL=

# Names players use for this site in chat, comma separated: "!load base"
#STASIS_LOCATION_NAME=base

# Max pearls per player at this site (-1 = unlimited)
#STASIS_SITE_MAX=3

# Max pearls per player across every site sharing the location name (-1 = no extra limit)
#STASIS_USER_MAX=-1

# How holograms above stasis chambers are drawn: head, body, text or off
#HOLOGRAM_RENDERER=body

# View distance in chunks (2-32). Lower it on small servers to save memory and CPU
# (./launch sets 4 by itself on machines with under 1 GB of RAM)
#MC_VIEW_DISTANCE=
